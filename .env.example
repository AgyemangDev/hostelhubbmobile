# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here.

# Google sign-in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CALLBACK_URL=

# Access fee shown in the app (GH₵)
EXPO_PUBLIC_ACCESS_FEE=

# Local only: sample bookings, agreement, tickets and storage orders (dev builds only).
# EXPO_PUBLIC_DEMO=1
