# Copy to `.env` for local development:  cp .env.example .env
#
# Why this exists: EXPO_PUBLIC_* values set in eas.json apply to EAS builds only.
# `expo start` and local xcodebuild/gradle runs read `.env` instead, so without
# it the app runs with those values undefined — transport fails with
# "Transport is not configured in this build", and Google Sign-In misbehaves.
#
# None of these are secrets: anything prefixed EXPO_PUBLIC_ is compiled into the
# app binary and can be read out of a shipped app. Real secrets must never live
# here — they belong on a server.
#
# Keep in sync with eas.json → build.<profile>.env.

# ── UniGo transport (partner API) ─────────────────────────────────────────────
# Publishable partner key. Scoped so it is safe to ship: it can browse open
# trips, create pending bookings, start payment and read back its own bookings.
# It cannot hold a seat without paying, and cannot see other partners' data.
# Reissue with: cd backend/unigo-backend && npm run partner:create -- --slug hostelhubb --rotate
EXPO_PUBLIC_UNIGO_API_URL=https://yenko-backend.onrender.com
EXPO_PUBLIC_UNIGO_PARTNER_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sign-In ────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CALLBACK_URL=https://hostelhubbgh.web.app/auth/callback

# ── Misc ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ACCESS_FEE=30
